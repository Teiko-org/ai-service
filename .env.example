# Chave(s) da API do Gemini (https://aistudio.google.com/)
# Opcao A — uma chave:
GEMINI_API_KEY=your_gemini_api_key_here

# Opcao B — 3+ chaves (rota em 429/503 apos esgotar fallback de modelos):
# GEMINI_API_KEYS=chave_1,chave_2,chave_3

# URL base do backend Java (Spring Boot)
CARAMBOLOS_API_URL=http://localhost:8080

# Modelo Gemini principal (gemini-2.5-flash-lite, gemini-2.5-flash, gemini-2.5-pro)
# Fallback automatico entre modelos em caso de rate limit (429)
GEMINI_MODEL=gemini-2.5-flash-lite

# Origens permitidas pelo CORS (separadas por virgula)
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006

# Nivel de log (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Ambiente: development | staging | production.
# Em production, ALLOW_ANONYMOUS_WRITES=true falha no startup.
ENVIRONMENT=development

# V3 — Tools de escrita (criacao de fornadas, bolos, pedidos)
# Default false. Quando true, o registry carrega as writes E exige CONFIRM_TOKEN_SECRET.
ENABLE_WRITE_TOOLS=false

# Segredo HMAC para preview-tokens (obrigatorio se ENABLE_WRITE_TOOLS=true;
# recomendado sempre — habilita botao Confirmar e evita dupla confirmacao em pedidos).
# Gere algo forte, ex.: python -c "import secrets; print(secrets.token_urlsafe(48))"
CONFIRM_TOKEN_SECRET=

# TTL do preview-token (em segundos). Padrao 120s.
CONFIRM_TOKEN_TTL_SECONDS=120

# Dev local: app ainda sem JWT no /ask — permite commit V3 sem Bearer (Java ja aceita).
# Em producao deixe false e envie Authorization no cliente.
ALLOW_ANONYMOUS_WRITES=false
